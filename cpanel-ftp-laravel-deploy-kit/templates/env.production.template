# ═══════════════════════════════════════════════════════════════════════════
#  Reference copy of the production .env the workflow WRITES on every deploy.
#  You do not upload this file — the workflow generates it from GitHub
#  Secrets/Variables. This exists so you can see exactly what lands on the
#  server, and so you know which knob controls which line.
#
#  ⚠ Editing .env on the server is pointless: the next deploy overwrites it.
#    Change the GitHub Secret/Variable instead, or add lines via EXTRA_ENV.
#
#  {{ … }} = comes from a GitHub Variable   ‹secret› = from a GitHub Secret
# ═══════════════════════════════════════════════════════════════════════════

APP_NAME="{{ vars.APP_NAME }}"
APP_ENV=production
APP_KEY=‹secrets.APP_KEY›
APP_DEBUG={{ vars.APP_DEBUG | default false }}
APP_URL={{ vars.APP_URL }}
APP_TIMEZONE={{ vars.APP_TIMEZONE | default UTC }}

APP_LOCALE={{ vars.APP_LOCALE | default en }}
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL={{ vars.LOG_LEVEL | default error }}

DB_CONNECTION=mysql
DB_HOST={{ vars.DB_HOST | default 127.0.0.1 }}
DB_PORT={{ vars.DB_PORT | default 3306 }}
DB_DATABASE=‹secrets.DB_DATABASE›
DB_USERNAME=‹secrets.DB_USERNAME›
DB_PASSWORD=‹secrets.DB_PASSWORD›

# database drivers keep shared hosting working with zero extra services.
# On a VPS with Redis available, switch CACHE_STORE/SESSION_DRIVER to redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER={{ vars.MAIL_MAILER | default log }}
MAIL_FROM_ADDRESS="{{ vars.MAIL_FROM_ADDRESS }}"
MAIL_FROM_NAME="{{ vars.APP_NAME }}"

VITE_APP_NAME="{{ vars.APP_NAME }}"

# ─────────────────────────────────────────────────────────────────────────
#  Everything below is pasted verbatim from the EXTRA_ENV secret.
#  Put anything project-specific there — one KEY=VALUE per line — instead of
#  editing the workflow YAML. Examples:
#
#     MAIL_MAILER=smtp
#     MAIL_HOST=smtp.gmail.com
#     MAIL_PORT=587
#     MAIL_USERNAME=you@gmail.com
#     MAIL_PASSWORD=your_app_password
#     ADMIN_EMAIL=admin@example.com
#     ADMIN_PASSWORD=change_me_now
#     STRIPE_KEY=pk_live_…
#     STRIPE_SECRET=sk_live_…
# ─────────────────────────────────────────────────────────────────────────
‹secrets.EXTRA_ENV›
